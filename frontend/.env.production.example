# =============================================================================
# PLUTO vProctor — Frontend Production Build Template
# Copy to: frontend/.env.production  before running: npm run build
# Never commit the real .env.production file — it is listed in .gitignore
# =============================================================================

# Backend API base URL — set to your Catalyst AppSail service URL after deployment
# Format: https://<appsail-service-name>-<project-id>.catalyst.zohocloud.com
VITE_API_BASE_URL=https://YOUR_APPSAIL_URL.catalyst.zohocloud.com
