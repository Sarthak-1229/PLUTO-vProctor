# ==============================================================================
# PLUTO vProctor Environment Configuration
# ==============================================================================

# Server & Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# v2 Feature Flags (safe defaults preserve v1 offline self-practice mode)
AUTH_ENABLED=False
HOSTED_ROOMS_ENABLED=False
LIVE_MEDIA_ENABLED=False
MEDIA_TRANSPORT_MODE=p2p
SFU_URL=

# Auth, Session & Cookie Configuration (set strong 32+ char SECRET_KEY in production)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False

# WebRTC P2P / NAT Traversal (STUN & TURN; leave TURN_CREDENTIAL empty in git)
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_SERVER_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Database Connection (SQLite by default, PostgreSQL supported in production)
# SQLite:
DATABASE_URL=sqlite:///backend/app/pluto.db
# PostgreSQL:
# DATABASE_URL=postgresql://pluto_user:pluto_password@localhost:5432/pluto_db

# Background Task Queue (Redis optional; fallback is in-memory worker queue)
# REDIS_URL=redis://localhost:6379/0

# Privacy & Retention Policy
RETENTION_DAYS=30

# Speech-to-Text (ASR) Configuration
# Providers: "auto" (detects available provider), "faster_whisper", "deepgram", "assemblyai"
ASR_PROVIDER=auto
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=3

# Optional Hosted Cloud Providers (Zero-network fallback works automatically when omitted)
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# LLM Inference (Ollama - Local Offline Inference)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_NUM_CTX=4096
LLM_KEEP_ALIVE=30s
LLM_TEMPERATURE=0.2

# Sentence Embedding Model (CPU-only to protect 6 GB VRAM)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

