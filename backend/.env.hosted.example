# =============================================================================
# PLUTO vProctor — Zoho Catalyst AppSail (Hosted/Staging) Environment Template
# Copy to: backend/.env  when deploying to Catalyst AppSail
# Set as AppSail environment variables via the Catalyst Console
# Never commit the real .env file — it is listed in .gitignore
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=staging
DEBUG=false

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set this in AppSail console → Environment Variables (never hardcode in source)
SECRET_KEY=REPLACE_WITH_REAL_SECRET_KEY_MINIMUM_32_CHARS
AUTH_ENABLED=true

# ── Database ──────────────────────────────────────────────────────────────────
# IMPORTANT: AppSail filesystem is EPHEMERAL — SQLite data is lost on scale-down.
# For the college demo, ephemeral SQLite is acceptable (demo data only).
# For persistent data, use an external Postgres or Catalyst Data Store adapter.
DATABASE_URL=sqlite:///./pluto.db

# ── API Server ────────────────────────────────────────────────────────────────
# AppSail injects $X_ZOHO_CATALYST_LISTEN_PORT — do not set API_PORT manually here
API_HOST=0.0.0.0
# CORS: set to your Catalyst Web Client Hosting domain after deployment
CORS_ORIGINS=["https://YOUR_PROJECT.catalyst.zohocloud.com"]

# ── LLM / Ollama ─────────────────────────────────────────────────────────────
# Ollama is NOT available on AppSail (no GPU, no persistent process).
# Leave these blank — the application falls back to the deterministic algorithm.
OLLAMA_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=10.0

# ── Zoho Catalyst Stratus Storage ────────────────────────────────────────────
# Fill in after creating a Stratus bucket in the Catalyst Console.
# AppSail → Environment Variables → add each line below.
STRATUS_ENDPOINT=https://storage.zohocloud.com
STRATUS_BUCKET=pluto-vproctor-staging
STRATUS_ACCESS_KEY=REPLACE_WITH_STRATUS_ACCESS_KEY
STRATUS_SECRET_KEY=REPLACE_WITH_STRATUS_SECRET_KEY
STRATUS_REGION=ap-south-1

# ── Feature Flags ─────────────────────────────────────────────────────────────
HOSTED_ROOMS_ENABLED=true
LIVE_MEDIA_ENABLED=true
MEDIA_TRANSPORT_MODE=p2p

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING
RETENTION_DAYS=7
REDIS_URL=
WHISPER_DEVICE=cpu
