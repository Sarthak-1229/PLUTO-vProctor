# =============================================================================
# PLUTO vProctor — Local Development Environment Template
# Copy to: backend/.env
# Never commit the real .env file — it is listed in .gitignore
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_NAME=PLUTO vProctor
APP_VERSION=0.1.0

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key
AUTH_ENABLED=true

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default — no setup needed)
DATABASE_URL=sqlite:///./backend/app/pluto.db

# PostgreSQL (optional — uncomment and fill to use Postgres instead of SQLite)
# DATABASE_URL=postgresql+psycopg://pluto:password@localhost:5432/pluto_db
# TEST_POSTGRES_URL=postgresql+psycopg://pluto:password@localhost:5432/pluto_test_db

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── LLM / Ollama ─────────────────────────────────────────────────────────────
# Local Ollama for offline AI inference. Requires: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_NUM_CTX=4096
LLM_KEEP_ALIVE=30s
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=1

# ── Speech / Whisper ──────────────────────────────────────────────────────────
WHISPER_DEVICE=cpu

# ── Zoho Catalyst Cloud Adapters ──────────────────────────────────────────────
# Leave blank for local development (uses local filesystem instead)
STRATUS_ENDPOINT=
STRATUS_BUCKET=
STRATUS_ACCESS_KEY=
STRATUS_SECRET_KEY=
STRATUS_REGION=ap-south-1

# ── Feature Flags ─────────────────────────────────────────────────────────────
HOSTED_ROOMS_ENABLED=true
LIVE_MEDIA_ENABLED=true
MEDIA_TRANSPORT_MODE=p2p

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
RETENTION_DAYS=30
REDIS_URL=
