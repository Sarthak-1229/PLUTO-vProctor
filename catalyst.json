{
  "appsail": [
    {
      "name": "pluto-backend",
      "source": "backend",
      "build_path": ".",
      "command": "python -m uvicorn backend.app.main:app --host 0.0.0.0 --port $X_ZOHO_CATALYST_LISTEN_PORT",
      "stack": "python_3_10",
      "memory": 2048,
      "env_variables": {
        "PYTHONPATH": ".",
        "ENVIRONMENT": "staging",
        "DEBUG": "false",
        "AUTH_ENABLED": "true",
        "HOSTED_ROOMS_ENABLED": "true",
        "LIVE_MEDIA_ENABLED": "true",
        "MEDIA_TRANSPORT_MODE": "p2p",
        "CORS_ORIGINS": "[\"https://pluto-vproctor-60088200944.development.catalystserverless.in\", \"http://localhost:5173\", \"http://127.0.0.1:5173\"]"
      }
    }
  ],
  "client": {
    "source": "frontend/dist"
  }
}
