{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PLUTO vProctor Question Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "text", "category", "type", "difficulty", "tags", "role_fit", "irt", "ideal_answer_points", "keywords", "scoring_rubric"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+-[0-9]{3}[a-z]?$",
      "description": "Stable human-readable id, e.g. beh-004, sysdes-002"
    },
    "version": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 8 },
    "category": {
      "type": "string",
      "enum": ["behavioral", "hr_culture", "situational", "aptitude", "tech_cs_fundamentals", "tech_backend", "tech_frontend", "tech_data_ml", "tech_system_design", "tech_pm"]
    },
    "subcategory": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["behavioral", "technical", "situational", "conceptual"]
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "role_fit": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Role slugs from the taxonomy, or '*' for any role"
    },
    "irt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "c", "calibration"],
      "properties": {
        "a": { "type": "number" },
        "b": { "type": "number", "description": "Difficulty on the Elo scale (seed = tier map)" },
        "c": { "type": "number", "minimum": 0, "maximum": 1 },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "n_responses", "seed_source", "last_calibrated"],
          "properties": {
            "status": { "type": "string", "enum": ["seed", "elo", "calibrated"] },
            "n_responses": { "type": "integer", "minimum": 0 },
            "seed_source": { "type": "string" },
            "last_calibrated": { "type": ["string", "null"] }
          }
        }
      }
    },
    "ideal_answer_points": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Gradable concept atoms; coverage is measured against these"
    },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "expected_star": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "situation": { "type": "string" },
            "task": { "type": "string" },
            "action": { "type": "string" },
            "result": { "type": "string" }
          }
        }
      }
    },
    "scoring_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_score", "dimensions"],
      "properties": {
        "max_score": { "type": "number", "exclusiveMinimum": 0 },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "weight", "criteria"],
            "properties": {
              "name": { "type": "string" },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 },
              "criteria": { "type": "string" }
            }
          }
        },
        "red_flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "follow_up_ids": { "type": "array", "items": { "type": "string" } },
    "easier_ids": { "type": "array", "items": { "type": "string" } },
    "harder_ids": { "type": "array", "items": { "type": "string" } },
    "expected_answer_seconds": { "type": "integer", "minimum": 10 },
    "source": { "type": "string" },
    "created_at": { "type": "string" },
    "usage_count": { "type": "integer", "minimum": 0 },
    "language": { "type": "string", "default": "en" }
  }
}
