# ==============================================================================
# PLUTO vProctor — Zoho Catalyst Staging Environment Configuration Template
# ==============================================================================
# Deploy to Catalyst AppSail via:
# catalyst appsail:var:set --name pluto-backend --key KEY --value VALUE
# Or configure in the Catalyst Console -> AppSail -> Environment Variables.

# Core Runtime Configuration
ENVIRONMENT=staging
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
PYTHONPATH=.

# Feature Gates
AUTH_ENABLED=true
HOSTED_ROOMS_ENABLED=true
LIVE_MEDIA_ENABLED=true
MEDIA_TRANSPORT_MODE=p2p

# Security & Session Authentication
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARACTERS
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Managed PostgreSQL Database (AWS ap-south-1 RDS or Supabase)
DATABASE_URL=postgresql+psycopg://pluto_user:SECURE_PASSWORD@external-postgres-host.ap-south-1.rds.amazonaws.com:5432/pluto_db

# Client CORS Origins (Catalyst Web Client Hosting Domains)
CORS_ORIGINS=["https://pluto-staging.catalystserverless.in","https://pluto-staging.catalystserverless.com"]

# Zoho Catalyst QuickML (Cloud Hosted LLM Inference — Qwen 2.5:3b)
QUICKML_ENDPOINT=https://api.catalyst.zoho.com/quickml/v1/predict
QUICKML_API_KEY=YOUR_CATALYST_QUICKML_API_KEY
QUICKML_MODEL=qwen2.5:3b

# Zoho Catalyst Stratus (S3-Compatible Object Storage for Recordings & Resumes)
STRATUS_ENDPOINT=https://stratus.catalyst.zoho.com
STRATUS_BUCKET=pluto-staging-media
STRATUS_ACCESS_KEY=YOUR_CATALYST_STRATUS_ACCESS_KEY
STRATUS_SECRET_KEY=YOUR_CATALYST_STRATUS_SECRET_KEY
STRATUS_REGION=ap-south-1

# WebRTC STUN / TURN Relay Servers (External Coturn VM in ap-south-1)
STUN_SERVERS=["stun:stun.l.google.com:19302","stun:relay.yourdomain.com:3478"]
TURN_SERVER_URLS=["turn:relay.yourdomain.com:3478?transport=udp","turn:relay.yourdomain.com:3478?transport=tcp"]
TURN_USERNAME=pluto_staging_turn
TURN_CREDENTIAL=CHANGE_THIS_TO_SECURE_COTURN_CREDENTIAL
